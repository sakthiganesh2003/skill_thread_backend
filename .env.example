# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Firebase Configuration
FIREBASE_PROJECT_ID=silkthread-1db8f
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@silkthread-1db8f.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Or use Firebase Service Account JSON file path:
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-key.json

# JWT Secret
JWT_SECRET=your-super-secret-key-change-in-production

# Email/Notification Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
